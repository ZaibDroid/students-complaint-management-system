APP_NAME=DCMS_API
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Karachi
APP_URL=https://api.domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL 8.0 Production Database (fill real credentials on server only)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dcms_prod
DB_USERNAME=dcms_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Sessions, Broadcast, Filesystem, Queue, Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.domain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# IMPORTANT: Backend/database/migrations/ does NOT include a `cache` table migration.
# Keep `file` (or `redis`) unless you run `php artisan cache:table && php artisan migrate`.
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production SMTP Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS="noreply@uetmardan.edu.pk"
MAIL_FROM_NAME="${APP_NAME}"

# Optional S3 Storage (only needed if FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum & Frontend Origins
SANCTUM_STATEFUL_DOMAINS=api.domain.com,app.domain.com
FRONTEND_URL=https://app.domain.com

# Reserved for Firebase Cloud Messaging push delivery (not active in NotificationService yet)
FCM_SERVER_KEY=

