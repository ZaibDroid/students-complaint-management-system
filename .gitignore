# ==========================================
# Student Complaint Management System .gitignore
# ==========================================

# OS & IDEs
.DS_Store
Thumbs.db
*.swp
*.log
*.tmp
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Backend / PHP / Laravel
Backend/.env
Backend/.env.backup
Backend/.env.production
Backend/vendor/
Backend/.phpunit.result.cache
Backend/storage/*.key
Backend/storage/framework/cache/data/*
Backend/storage/framework/sessions/*
Backend/storage/framework/testing/*
Backend/storage/framework/views/*
Backend/storage/logs/*
Backend/bootstrap/cache/*
!Backend/storage/framework/cache/data/.gitignore
!Backend/storage/framework/sessions/.gitignore
!Backend/storage/framework/testing/.gitignore
!Backend/storage/framework/views/.gitignore
!Backend/storage/logs/.gitignore
!Backend/bootstrap/cache/.gitignore

# Frontend / Flutter / Dart
Frontend/.dart_tool/
Frontend/.flutter-plugins
Frontend/.flutter-plugins-dependencies
Frontend/.packages
Frontend/.pub-cache/
Frontend/.pub/
Frontend/build/
Frontend/coverage/
Frontend/android/app/debug
Frontend/android/app/profile
Frontend/android/app/release
Frontend/android/.gradle
Frontend/android/local.properties
Frontend/ios/Flutter/.last_build_id
Frontend/ios/Flutter/Flutter.podspec
Frontend/ios/Flutter/Generated.xcconfig
Frontend/ios/Flutter/app.framework
Frontend/ios/Pods/
Frontend/ios/.symlinks/
Frontend/macos/Flutter/ephemeral
Frontend/windows/flutter/ephemeral
Frontend/linux/flutter/ephemeral
Frontend/app.*.symbols
Frontend/app.*.map.json

*.sqlite
*.sqlite-journal
*.sqlite3
