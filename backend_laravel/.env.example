APP_NAME="DCMS UET Mardan"
APP_ENV=local
APP_KEY=base64:dcmsSecretKeyExampleUETMardan2026Generated=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL / PostgreSQL / SQLite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dcms_uetmardan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Mail Configuration for OTP and Notifications
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="dcms@uetmardan.edu.pk"
MAIL_FROM_NAME="DCMS UET Mardan"

# Firebase Cloud Messaging (FCM) Credentials for Flutter Push Notifications
FCM_PROJECT_ID=dcms-uetmardan
FCM_SERVER_KEY=your_firebase_server_key_or_service_account_token
FCM_SERVICE_ACCOUNT_JSON=storage/app/firebase-service-account.json

# University Constraints
ALLOWED_EMAIL_DOMAIN="uetmardan.edu.pk"
